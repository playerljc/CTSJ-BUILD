{
  "name": "@ctsj/build",
  "version": "6.5.0",
  "description": "一个基于 Rspack 的打包工具",
  "bin": {
    "ctbuild": "./bin/build.js",
    "ctcopy": "./bin/copy.js"
  },
  "scripts": {
    "devDll": "rspack build --config rspack.dll.js",
    "startapp": "cross-env REAP_PATH=dev rspack serve --open --config rspack.dev.js",
    "buildapp": "cross-env REAP_PATH=dev rspack build --config rspack.prod.js",
    "buildpackage": "rimraf lib && babel src -d lib/src --ignore __tests__ && gulp",
    "generatorchangelog": "bd changelog/CHANGELOG.html",
    "publish": "npm publish --access public"
  },
  "keywords": [
    "CTSJ-BUILD",
    "CTMobile-UI",
    "CTSJ-UI",
    "playerljc",
    "gulp",
    "babel",
    "rspack"
  ],
  "author": "playerljc <playerljc@163.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/playerljc/CTSJ-BUILD.git"
  },
  "bugs": {
    "url": "https://github.com/playerljc/CTSJ-BUILD/issues"
  },
  "devDependencies": {
    "@umijs/fabric": "^4.0.1",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-proposal-function-bind": "^7.27.1",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.28.2",
    "@rspack/cli": "^1.4.11",
    "@rspack/core": "^1.4.11",
    "@rspack/dev-server": "^1.1.3",
    "@rspack/plugin-react-refresh": "^1.4.3",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.1.3",
    "babel-plugin-import": "^1.13.8",
    "commander": "^10.0.1",
    "compression-webpack-plugin": "^11.1.0",
    "core-js": "^3.44.0",
    "cp-cli": "^2.0.0",
    "cross-env": "^10.0.0",
    "css-loader": "^7.1.2",
    "csv-loader": "^3.0.5",
    "ejs-loader": "^0.5.0",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-typescript": "^6.0.0-alpha.1",
    "gulp-uglify": "^3.0.2",
    "html-webpack-plugin": "^5.6.3",
    "json-loader": "^0.5.7",
    "less": "^4.4.0",
    "less-loader": "^12.3.0",
    "merge2": "^1.4.1",
    "npmlog": "^7.0.1",
    "postcss-loader": "^8.1.1",
    "raw-loader": "^4.0.2",
    "react-refresh": "^0.17.0",
    "rimraf": "^6.0.1",
